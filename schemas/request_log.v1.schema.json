{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "indicspec/request_log/v1",
  "title": "IndicSpec per-request log line (one JSON object per line in results/raw/<run>/requests.jsonl)",
  "type": "object",
  "required": [
    "schema_version", "run_id", "arm", "engine", "model", "language", "task", "prompt_id",
    "split", "concurrency", "load_mode", "repeat", "input_tokens", "output_tokens",
    "ttft_s", "e2e_latency_s", "error"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "minLength": 1},
    "arm": {"type": "string", "pattern": "^A[0-9]+(\\.[A-Za-z0-9_-]+)?$"},
    "engine": {"enum": ["vllm", "sglang", "replay"]},
    "model": {"type": "string"},
    "language": {"enum": ["en", "hi", "ta", "te", "kn", "ml"]},
    "task": {"type": "string"},
    "prompt_id": {"type": "string"},
    "split": {"enum": ["pilot", "tuning", "report", "heldout", "smoke"]},
    "concurrency": {"type": "integer", "minimum": 1},
    "load_mode": {"enum": ["closed_loop", "poisson"]},
    "request_rate": {"type": ["number", "null"]},
    "repeat": {"type": "integer", "minimum": 0},
    "draft_params": {"type": "object"},
    "temperature": {"type": "number", "minimum": 0},
    "seed": {"type": ["integer", "null"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "output_chars": {"type": ["integer", "null"], "minimum": 0},
    "output_words": {"type": ["integer", "null"], "minimum": 0},
    "send_ts": {"type": ["number", "null"]},
    "ttft_s": {"type": ["number", "null"], "minimum": 0},
    "itl_s": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0}},
    "tpot_s": {"type": ["number", "null"], "minimum": 0},
    "e2e_latency_s": {"type": ["number", "null"], "minimum": 0},
    "spec_accepted_tokens": {"type": ["integer", "null"], "minimum": 0},
    "spec_proposed_tokens": {"type": ["integer", "null"], "minimum": 0},
    "spec_verify_steps": {"type": ["integer", "null"], "minimum": 0},
    "acceptance_length": {"type": ["number", "null"], "minimum": 1},
    "spec_metric_source": {"type": ["string", "null"], "description": "where the spec counters came from: per-request field, /metrics delta, log"},
    "spec_engine_raw": {"type": ["object", "null"], "description": "engine per-request speculative metrics verbatim (optional, additive)"},
    "output_token_ids": {"type": ["array", "null"], "items": {"type": "integer"}},
    "error": {"type": ["string", "null"]}
  }
}
